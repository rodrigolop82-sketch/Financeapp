# Copia este archivo a .env.local y pon tus valores. Nunca subas llaves reales al repo.

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Llave secreta: solo en el servidor, salta el RLS.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_ANNUAL_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Anthropic (Zafi AI)
ANTHROPIC_API_KEY=sk-ant-...

# Push notifications (VAPID): npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notificaciones@zafiapp.com

# Crons de Vercel (/api/cron/*)
CRON_SECRET=

# Correo con Resend (feedback "Envíanos tu idea" → hola@zafiapp.com).
# Sin llave, el mensaje se guarda igual y solo se registra un aviso.
RESEND_API_KEY=
# Remitente (dominio verificado en Resend). Por defecto: Zafi <hola@zafiapp.com>
FEEDBACK_FROM_EMAIL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
