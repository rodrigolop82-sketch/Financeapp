# Copia este archivo a .env.local y pon tus valores. Nunca subas llaves reales al repo.

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Llave secreta: solo en el servidor, salta el RLS.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Recurrente (cobros; ver docs/recurrente.md). Llaves TEST del Sandbox para probar.
RECURRENTE_SECRET_KEY=sk_test_...
RECURRENTE_PUBLIC_KEY=pk_test_...
RECURRENTE_WEBHOOK_SECRET=whsec_...
RECURRENTE_PRODUCT_PREMIUM_MONTHLY=price_...
RECURRENTE_PRODUCT_PREMIUM_ANNUAL=price_...
RECURRENTE_PRODUCT_FAMILY_MONTHLY=price_...
RECURRENTE_PRODUCT_FAMILY_ANNUAL=price_...

# Anthropic (Zafi AI)
ANTHROPIC_API_KEY=sk-ant-...

# Push notifications (VAPID): npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notificaciones@zafiapp.com

# Crons de Vercel (/api/cron/*). Sin él, en producción el cron de avisos no corre.
CRON_SECRET=

# Apple Pay: enlace de iCloud del atajo publicado (ver docs/apple-pay-atajo.md).
# Sin él, el botón "Instalar el atajo de Zafi" se muestra deshabilitado.
NEXT_PUBLIC_APPLE_PAY_SHORTCUT_URL=

# Correo con Resend (feedback "Envíanos tu idea" → hola@zafiapp.com).
# Sin llave, el mensaje se guarda igual y solo se registra un aviso.
RESEND_API_KEY=
# Remitente (dominio verificado en Resend). Por defecto: Zafi <hola@zafiapp.com>
FEEDBACK_FROM_EMAIL=

# Admin (/admin): además del usuario maestro, un correo admin opcional.
ADMIN_EMAIL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
